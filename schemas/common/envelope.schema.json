{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.acn.example/0.1/common/envelope.schema.json",
  "title": "ACN commerce envelope",
  "type": "object",
  "required": [
    "specVersion", "messageId", "transactionId", "documentType",
    "sender", "recipient", "createdAt", "expiresAt", "idempotencyKey", "document"
  ],
  "properties": {
    "specVersion": {"const": "0.1"},
    "messageId": {"type": "string", "pattern": "^msg_[A-Za-z0-9_-]{8,128}$"},
    "transactionId": {"type": "string", "pattern": "^txn_[A-Za-z0-9_-]{8,128}$"},
    "documentType": {"enum": ["request_for_quote", "quotation", "quotation_counteroffer", "quotation_acceptance", "approval_evidence", "purchase_order", "order_acknowledgement", "transaction_cancellation", "order_cancellation_request", "order_cancellation_response", "shipment_notice", "goods_receipt", "fulfillment_status", "invoice", "payment_intent", "payment_result", "settlement_confirmation", "dispute_opened", "dispute_resolved"]},
    "sender": {"type": "string", "pattern": "^agent:[A-Za-z0-9._:-]{3,240}$"},
    "recipient": {"type": "string", "pattern": "^agent:[A-Za-z0-9._:-]{3,240}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 255},
    "inReplyTo": {"type": "string", "pattern": "^msg_[A-Za-z0-9_-]{8,128}$"},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
      "properties": {
        "acn.network": {
          "type": "object",
          "properties": {
            "productCategories": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,99}$"}},
            "reservationEvidence": {
              "type": "object",
              "required": ["reservationId", "quotationMessageId", "provider", "expiresAt", "evidenceHash"],
              "properties": {
                "reservationId": {"type": "string", "minLength": 1, "maxLength": 255},
                "quotationMessageId": {"type": "string", "pattern": "^msg_[A-Za-z0-9_-]{8,128}$"},
                "provider": {"type": "string", "minLength": 1, "maxLength": 255},
                "expiresAt": {"type": "string", "format": "date-time"},
                "evidenceHash": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "signature": {
      "type": "object",
      "required": ["keyId", "algorithm", "createdAt", "value"],
      "properties": {
        "keyId": {"type": "string", "pattern": "^key:[A-Za-z0-9._:-]{3,240}$"},
        "algorithm": {"const": "Ed25519"},
        "createdAt": {"type": "string", "format": "date-time"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      },
      "additionalProperties": false
    },
    "document": {"type": "object"}
  },
  "additionalProperties": false
}
