{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.acn.example/0.1/procurement/order-acknowledgement.schema.json","title":"ACN order acknowledgement","type":"object","required":["purchaseOrderMessageId","orderNumber","accepted"],"properties":{"purchaseOrderMessageId":{"type":"string","pattern":"^msg_[A-Za-z0-9_-]{8,128}$"},"orderNumber":{"type":"string","minLength":1,"maxLength":128},"accepted":{"type":"boolean"},"expectedDeliveryAt":{"type":"string","format":"date-time"},"rejectionReason":{"type":"string","minLength":1,"maxLength":500}},"additionalProperties":false}
