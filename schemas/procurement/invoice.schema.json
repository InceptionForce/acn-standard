{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.acn.example/0.1/procurement/invoice.schema.json","title":"ACN invoice","type":"object","required":["invoiceNumber","purchaseOrderMessageId","currency","subtotal","tax","total","dueAt"],"properties":{"invoiceNumber":{"type":"string","minLength":1,"maxLength":128},"purchaseOrderMessageId":{"type":"string","pattern":"^msg_[A-Za-z0-9_-]{8,128}$"},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"subtotal":{"type":"string"},"tax":{"type":"string"},"total":{"type":"string"},"dueAt":{"type":"string","format":"date-time"}},"additionalProperties":false}
