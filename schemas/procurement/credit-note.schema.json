{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.acn.example/0.1/procurement/credit-note.schema.json","title":"ACN credit note","type":"object","required":["creditNoteNumber","invoiceMessageId","returnReceiptMessageId","currency","subtotal","tax","total","issuedAt"],"properties":{"creditNoteNumber":{"type":"string","minLength":1,"maxLength":128},"invoiceMessageId":{"type":"string","pattern":"^msg_[A-Za-z0-9_-]{8,128}$"},"returnReceiptMessageId":{"type":"string","pattern":"^msg_[A-Za-z0-9_-]{8,128}$"},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"subtotal":{"type":"string"},"tax":{"type":"string"},"total":{"type":"string"},"issuedAt":{"type":"string","format":"date-time"},"reason":{"type":"string","minLength":1,"maxLength":500}},"additionalProperties":false}
