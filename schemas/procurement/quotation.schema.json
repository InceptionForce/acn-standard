{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.acn.example/0.1/procurement/quotation.schema.json",
  "title": "ACN quotation document",
  "type": "object",
  "required": ["currency", "validUntil", "lines", "total"],
  "properties": {
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "validUntil": {"type": "string", "format": "date-time"},
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["rfqLineId", "quantity", "unit", "unitPrice", "lineTotal"],
        "properties": {
          "rfqLineId": {"type": "string", "minLength": 1, "maxLength": 128},
          "quantity": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$"},
          "unit": {"type": "string", "minLength": 1, "maxLength": 32},
          "unitPrice": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$"},
          "lineTotal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"}
        },
        "additionalProperties": false
      }
    },
    "total": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,2})?$"},
    "paymentTerms": {"type": "string", "maxLength": 500},
    "deliveryTerms": {"type": "string", "maxLength": 500}
  },
  "additionalProperties": false
}
