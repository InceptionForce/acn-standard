{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.acn.example/0.1/procurement/return-receipt.schema.json","title":"ACN return receipt","type":"object","required":["receiptId","authorizationMessageId","receivedAt","lines"],"properties":{"receiptId":{"type":"string","minLength":1,"maxLength":128},"authorizationMessageId":{"type":"string","pattern":"^msg_[A-Za-z0-9_-]{8,128}$"},"receivedAt":{"type":"string","format":"date-time"},"note":{"type":"string","minLength":1,"maxLength":500},"lines":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"object","required":["rfqLineId","quantity","unit"],"properties":{"rfqLineId":{"type":"string","minLength":1,"maxLength":128},"quantity":{"type":"string","pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$"},"unit":{"type":"string","minLength":1,"maxLength":32},"reason":{"type":"string","minLength":1,"maxLength":500}},"additionalProperties":false}}},"additionalProperties":false}
