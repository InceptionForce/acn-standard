{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.acn.example/0.1/identity/credential.schema.json",
  "title": "ACN Ed25519 credential",
  "type": "object",
  "required": ["keyId", "algorithm", "publicKey", "notBefore", "expiresAt"],
  "properties": {
    "keyId": {"type": "string", "pattern": "^key:[A-Za-z0-9._:-]{3,240}$"},
    "algorithm": {"const": "Ed25519"},
    "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "notBefore": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
