{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.acn.example/0.1/procurement/fulfillment-status.schema.json","title":"ACN fulfillment status","type":"object","required":["purchaseOrderMessageId","orderNumber","status","occurredAt"],"properties":{"purchaseOrderMessageId":{"type":"string","pattern":"^msg_[A-Za-z0-9_-]{8,128}$"},"orderNumber":{"type":"string","minLength":1,"maxLength":128},"status":{"enum":["processing","shipped","delivered"]},"occurredAt":{"type":"string","format":"date-time"},"trackingReference":{"type":"string","minLength":1,"maxLength":500},"note":{"type":"string","minLength":1,"maxLength":500}},"additionalProperties":false}
