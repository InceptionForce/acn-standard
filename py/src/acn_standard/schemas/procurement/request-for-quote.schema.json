{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.acn.example/0.1/procurement/request-for-quote.schema.json",
  "title": "ACN request for quote document",
  "type": "object",
  "required": ["currency", "deliveryLocation", "responseDeadline", "items"],
  "properties": {
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "deliveryLocation": {"type": "string", "minLength": 1, "maxLength": 500},
    "responseDeadline": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["lineId", "description", "quantity", "unit"],
        "properties": {
          "lineId": {"type": "string", "minLength": 1, "maxLength": 128},
          "sku": {"type": "string", "minLength": 1, "maxLength": 128},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "quantity": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$"},
          "unit": {"type": "string", "minLength": 1, "maxLength": 32},
          "specifications": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
