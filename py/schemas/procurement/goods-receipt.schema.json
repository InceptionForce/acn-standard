{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.acn.example/0.1/procurement/goods-receipt.schema.json","title":"ACN goods receipt","type":"object","required":["receiptId","shipmentNoticeMessageId","orderNumber","receivedAt","lines"],"properties":{"receiptId":{"type":"string","minLength":1,"maxLength":128},"shipmentNoticeMessageId":{"type":"string","pattern":"^msg_[A-Za-z0-9_-]{8,128}$"},"orderNumber":{"type":"string","minLength":1,"maxLength":128},"receivedAt":{"type":"string","format":"date-time"},"note":{"type":"string","maxLength":500},"lines":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"object","required":["rfqLineId","acceptedQuantity","rejectedQuantity","unit"],"properties":{"rfqLineId":{"type":"string","minLength":1,"maxLength":128},"acceptedQuantity":{"type":"string","pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$"},"rejectedQuantity":{"type":"string","pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$"},"unit":{"type":"string","minLength":1,"maxLength":32},"rejectionReason":{"type":"string","maxLength":500}},"additionalProperties":false}}},"additionalProperties":false}
