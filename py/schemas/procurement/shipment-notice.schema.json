{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.acn.example/0.1/procurement/shipment-notice.schema.json","title":"ACN shipment notice","type":"object","required":["shipmentId","purchaseOrderMessageId","orderNumber","shippedAt","lines"],"properties":{"shipmentId":{"type":"string","minLength":1,"maxLength":128},"purchaseOrderMessageId":{"type":"string","pattern":"^msg_[A-Za-z0-9_-]{8,128}$"},"orderNumber":{"type":"string","minLength":1,"maxLength":128},"shippedAt":{"type":"string","format":"date-time"},"carrier":{"type":"string","maxLength":128},"trackingReference":{"type":"string","maxLength":128},"lines":{"type":"array","minItems":1,"maxItems":500,"items":{"type":"object","required":["rfqLineId","quantity","unit"],"properties":{"rfqLineId":{"type":"string","minLength":1,"maxLength":128},"quantity":{"type":"string","pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,6})?$"},"unit":{"type":"string","minLength":1,"maxLength":32}},"additionalProperties":false}}},"additionalProperties":false}
